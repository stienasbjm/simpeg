<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /simpeg/

    # Jika request adalah file atau folder nyata, biarkan lewat
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Teruskan semua request ke public/index.php
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Sembunyikan folder sensitif dari akses langsung
<FilesMatch "\.(log|sql|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
