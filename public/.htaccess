<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /simpeg/public/

    # Blokir akses langsung ke file .php (kecuali index.php & portal.php)
    RewriteCond %{THE_REQUEST} \s/simpeg/public/(?!index\.php|portal\.php)[^?\s]*\.php [NC]
    RewriteRule ^ - [F,L]

    # Jika bukan file/folder nyata, arahkan ke index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Larang akses langsung ke file log
<FilesMatch "\.(log|sql|md|txt)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
